<div class="space-y-4">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold text-gray-900">Attendance</h2>
        <span class="text-sm font-medium text-gray-500">
            <%= moment().format('MMM Do') %>
        </span>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-2 gap-3">
        <div class="bg-green-50 p-4 rounded-xl border border-green-100">
            <span class="block text-2xl font-bold text-green-700">
                <%= presentUsers.length %>
            </span>
            <span class="text-xs font-medium text-green-600">Present</span>
        </div>
        <div class="bg-red-50 p-4 rounded-xl border border-red-100">
            <span class="block text-2xl font-bold text-red-700">
                <%= absentUsers.length %>
            </span>
            <span class="text-xs font-medium text-red-600">Absent</span>
        </div>
    </div>

    <!-- Lists -->
    <div class="space-y-6">
        <!-- Present -->
        <div>
            <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">Who's In</h3>

            <% if (presentUsers.length> 0) { %>
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 divide-y divide-gray-100">
                    <% presentUsers.forEach(({ user, record })=> { %>
                        <div class="p-4 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="relative">
                                    <div class="w-10 h-10 rounded-full overflow-hidden bg-gray-200">
                                        <img src="<%= user.profilePhoto || 'https://ui-avatars.com/api/?name=' + user.name %>"
                                            class="w-full h-full object-cover">
                                    </div>
                                    <div
                                        class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 border-2 border-white rounded-full">
                                    </div>
                                </div>
                                <div>
                                    <h4 class="text-sm font-bold text-gray-900">
                                        <%= user.name %>
                                    </h4>
                                    <p class="text-xs text-gray-500">
                                        <%= user.role ? user.role.name : 'Employee' %>
                                    </p>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="block text-sm font-bold text-gray-900">
                                    <%= record.clockIn ? moment(record.clockIn).format('h:mm A') : '--:--' %>
                                </span>
                                <span class="text-xs text-gray-400">Clock In</span>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } else { %>
                    <div class="text-center py-6 bg-white rounded-xl border border-dashed border-gray-200">
                        <p class="text-sm text-gray-400">No one has clocked in yet.</p>
                    </div>
                    <% } %>
        </div>

        <!-- Absent -->
        <div>
            <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">Who's Out</h3>

            <% if (absentUsers.length> 0) { %>
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 divide-y divide-gray-100">
                    <% absentUsers.forEach(({ user })=> { %>
                        <div class="p-4 flex items-center gap-3 opacity-60">
                            <div class="grayscale">
                                <div class="w-10 h-10 rounded-full overflow-hidden bg-gray-200">
                                    <img src="<%= user.profilePhoto || 'https://ui-avatars.com/api/?name=' + user.name %>"
                                        class="w-full h-full object-cover">
                                </div>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-gray-900">
                                    <%= user.name %>
                                </h4>
                                <p class="text-xs text-gray-500">Not Logged In</p>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>
        </div>
    </div>
</div>