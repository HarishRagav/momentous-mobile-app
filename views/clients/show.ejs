<div class="pb-20">
    <% if (typeof error !=='undefined' && error) { %>
        <div class="bg-red-50 border-l-4 border-red-500 p-4 m-4 rounded shadow-sm">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-exclamation-circle text-red-500"></i>
                </div>
                <div class="ml-3">
                    <p class="text-xs text-red-700 font-bold">
                        <%= decodeURIComponent(error) %>
                    </p>
                </div>
            </div>
        </div>
        <% } %>

            <!-- Header with Back and Options -->
            <div class="bg-white sticky top-0 z-30 px-4 py-3 shadow-sm flex items-center gap-3">
                <a href="/clients" class="text-gray-500 hover:text-gray-900">
                    <i class="fas fa-arrow-left text-lg"></i>
                </a>
                <h1 class="text-lg font-bold text-gray-900 truncate flex-1">
                    <%= client.name %>
                </h1>
                <button onclick="document.getElementById('editModal').classList.remove('hidden')"
                    class="text-primary-600 font-medium text-sm">
                    <i class="fas fa-edit"></i> Edit
                </button>
            </div>

            <div class="p-4 space-y-6">
                <!-- Basic Info Card -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 relative overflow-hidden">
                    <!-- Decorator -->
                    <div
                        class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-br from-indigo-50 to-purple-50 rounded-bl-full -z-0">
                    </div>

                    <div class="relative z-10 grid grid-cols-2 gap-y-4 gap-x-2">
                        <div class="col-span-2">
                            <span
                                class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-600 text-xs font-bold uppercase tracking-wider">
                                <%= client.event || 'No Event Type' %>
                            </span>
                        </div>

                        <div>
                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Date</label>
                            <p class="text-sm font-bold text-gray-900 mt-0.5">
                                <i class="fas fa-calendar-day text-indigo-400 mr-1.5"></i>
                                <%= client.eventDate ? moment(client.eventDate).format('MMM Do, YY') : 'TBD' %>
                            </p>
                        </div>

                        <div>
                            <label class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Location</label>
                            <p class="text-sm font-bold text-gray-900 mt-0.5 truncate">
                                <i class="fas fa-map-pin text-red-400 mr-1.5"></i>
                                <%= client.location || 'TBD' %>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Shoot Services -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-4">
                    <div class="p-4 border-b border-gray-50 flex justify-between items-center">
                        <h3 class="text-xs font-bold text-indigo-900 uppercase tracking-wide flex items-center gap-2">
                            <i class="fas fa-camera text-indigo-500"></i> Shoot Services
                        </h3>
                    </div>

                    <form action="/clients/<%= client._id %>/update-assignments" method="POST">
                        <div class="p-2 space-y-2">
                            <% if (typeof shootServices !=='undefined' && shootServices.length> 0) { %>
                                <% shootServices.forEach((item, index)=> { %>
                                    <div
                                        class="flex items-center justify-between p-3 bg-gray-50 rounded-xl border border-gray-100">
                                        <div class="flex items-center gap-3 w-full">
                                            <div
                                                class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xs font-bold shrink-0">
                                                <%= item.name.charAt(0) %>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-xs font-bold text-gray-900 truncate mb-1">
                                                    <%= item.name %>
                                                </p>

                                                <!-- Hidden Inputs for Sync -->
                                                <input type="hidden" name="assignments[<%= index %>][serviceName]"
                                                    value="<%= item.name %>">
                                                <input type="hidden" name="assignments[<%= index %>][type]"
                                                    value="Shoot">

                                                <!-- Assignment Dropdown -->
                                                <select name="assignments[<%= index %>][assignedTo]"
                                                    class="w-full text-[10px] py-1 pl-2 pr-6 rounded-lg border-gray-200 bg-white focus:ring-indigo-500 focus:border-indigo-500">
                                                    <option value="">Select Employee...</option>
                                                    <% users.forEach(user=> { %>
                                                        <option value="<%= user._id %>" <%=(item.assignment &&
                                                            item.assignment.assigneeId.toString()===user._id.toString())
                                                            ? 'selected' : '' %>>
                                                            <%= user.name %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>

                                        <!-- Buttons Row -->
                                        <div class="flex gap-3 mt-4">
                                            <button type="button" onclick="openAssignModal('Shoot')"
                                                class="flex-1 py-4 text-xs font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 rounded-xl transition-colors">
                                                + Add Service
                                            </button>
                                            <button type="submit"
                                                class="flex-1 btn-primary py-4 rounded-xl font-bold text-sm shadow-lg shadow-primary-600/30">
                                                Save All
                                            </button>
                                        </div>
                                        <% } else { %>
                                            <p class="text-xs text-gray-400 italic p-2 text-center">No shoot services
                                                found</p>

                                            <button type="button" onclick="openAssignModal('Shoot')"
                                                class="w-full py-4 text-xs font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 rounded-xl transition-colors mt-2">
                                                + Add Service
                                            </button>
                                            <% } %>
                        </div>
                    </form>
                </div>

                <!-- Edit Services -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-4">
                    <div class="p-4 border-b border-gray-50 flex justify-between items-center">
                        <h3 class="text-xs font-bold text-emerald-900 uppercase tracking-wide flex items-center gap-2">
                            <i class="fas fa-laptop text-emerald-500"></i> Edit Services
                        </h3>
                    </div>

                    <form action="/clients/<%= client._id %>/update-assignments" method="POST">
                        <div class="p-2 space-y-2">
                            <% if (typeof editServices !=='undefined' && editServices.length> 0) { %>
                                <% editServices.forEach((item, index)=> { %>
                                    <div
                                        class="flex items-center justify-between p-3 bg-gray-50 rounded-xl border border-gray-100">
                                        <div class="flex items-center gap-3 w-full">
                                            <div
                                                class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs font-bold shrink-0">
                                                <%= item.name.charAt(0) %>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-xs font-bold text-gray-900 truncate mb-1">
                                                    <%= item.name %>
                                                </p>

                                                <!-- Hidden Inputs for Sync -->
                                                <input type="hidden" name="assignments[<%= index %>][serviceName]"
                                                    value="<%= item.name %>">
                                                <input type="hidden" name="assignments[<%= index %>][type]"
                                                    value="Edit">

                                                <!-- Assignment Dropdown -->
                                                <select name="assignments[<%= index %>][assignedTo]"
                                                    class="w-full text-[10px] py-1 pl-2 pr-6 rounded-lg border-gray-200 bg-white focus:ring-emerald-500 focus:border-emerald-500">
                                                    <option value="">Select Employee...</option>
                                                    <% users.forEach(user=> { %>
                                                        <option value="<%= user._id %>" <%=(item.assignment &&
                                                            item.assignment.assigneeId.toString()===user._id.toString())
                                                            ? 'selected' : '' %>>
                                                            <%= user.name %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>

                                        <!-- Buttons Row -->
                                        <div class="flex gap-3 mt-4">
                                            <button type="button" onclick="openAssignModal('Edit')"
                                                class="flex-1 py-4 text-xs font-bold text-emerald-600 bg-emerald-50 hover:bg-emerald-100 rounded-xl transition-colors">
                                                + Add Service
                                            </button>
                                            <button type="submit"
                                                class="flex-1 btn-emerald py-4 rounded-xl font-bold text-sm shadow-lg shadow-emerald-600/30 bg-emerald-600 text-white hover:bg-emerald-700">
                                                Save All
                                            </button>
                                        </div>
                                        <% } else { %>
                                            <p class="text-xs text-gray-400 italic p-2 text-center">No edit services
                                                found</p>

                                            <button type="button" onclick="openAssignModal('Edit')"
                                                class="w-full py-4 text-xs font-bold text-emerald-600 bg-emerald-50 hover:bg-emerald-100 rounded-xl transition-colors mt-2">
                                                + Add Service
                                            </button>
                                            <% } %>
                        </div>
                    </form>
                </div>

                <!-- Client Events (from ClientEvent model) -->
                <% if (typeof clientEvents !=='undefined' && clientEvents.length> 0) { %>
                    <div class="mb-4 space-y-3">
                        <h3
                            class="text-xs font-bold text-gray-900 uppercase tracking-wide px-1 flex items-center gap-2 mb-2">
                            <i class="fas fa-calendar-alt text-gray-400"></i> Client Events (<%= clientEvents.length %>)
                        </h3>

                        <% clientEvents.forEach((evt)=> { %>
                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
                                <div class="flex justify-between items-start mb-2">
                                    <div class="flex items-start gap-3">
                                        <div
                                            class="w-10 h-10 rounded-xl bg-gray-50 flex items-center justify-center text-gray-400 flex-shrink-0">
                                            <i class="fas fa-calendar-week text-lg"></i>
                                        </div>
                                        <div>
                                            <h4 class="text-sm font-bold text-gray-900 leading-tight">
                                                <%= evt.eventType || evt.eventName || 'Event' %>
                                            </h4>
                                            <p class="text-[11px] text-gray-500 font-medium mt-0.5">
                                                <%= evt.eventDate ? moment(evt.eventDate).format('MMM Do, YY')
                                                    : 'No date' %>
                                                    <% if (evt.location) { %> <span class="text-gray-300 mx-1">•</span>
                                                        <%= evt.location %>
                                                            <% } %>
                                            </p>
                                        </div>
                                    </div>
                                    <% if (evt.status) { %>
                                        <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold 
                                            <% if (evt.status === 'Upcoming') { %>bg-gray-100 text-gray-600
                                            <% } else { %>bg-gray-50 text-gray-500<% } %>">
                                            <%= evt.status %>
                                        </span>
                                        <% } %>
                                </div>

                                <!-- Assignees (Mixed) -->
                                <% const shootAssignees=evt.assignedEmployees ? evt.assignedEmployees.filter(a=> a.type
                                    === 'Shoot') : [];
                                    const editAssignees = evt.assignedEmployees ? evt.assignedEmployees.filter(a =>
                                    a.type === 'Edit') : [];
                                    const hasAssignees = shootAssignees.length > 0 || editAssignees.length > 0;
                                    %>

                                    <div class="flex flex-wrap gap-1.5 mt-3 mb-4">
                                        <% if (hasAssignees) { %>
                                            <% shootAssignees.forEach(a=> { %>
                                                <span
                                                    class="inline-flex items-center px-2 py-1 rounded-md text-[10px] font-bold bg-indigo-50 text-indigo-600">
                                                    <i class="fas fa-camera mr-1.5 opacity-70"></i>
                                                    <%= a.assignee %>
                                                </span>
                                                <% }) %>
                                                    <% editAssignees.forEach(a=> { %>
                                                        <span
                                                            class="inline-flex items-center px-2 py-1 rounded-md text-[10px] font-bold bg-emerald-50 text-emerald-600">
                                                            <i class="fas fa-laptop mr-1.5 opacity-70"></i>
                                                            <%= a.assignee %>
                                                        </span>
                                                        <% }) %>
                                                            <% } else if (evt.shootTeam || evt.editTeam) { %>
                                                                <!-- Fallback -->
                                                                <% if (evt.shootTeam) { %>
                                                                    <span
                                                                        class="inline-flex items-center px-2 py-1 rounded-md text-[10px] font-bold bg-indigo-50 text-indigo-600">
                                                                        <i class="fas fa-camera mr-1.5 opacity-70"></i>
                                                                        <%= evt.shootTeam %>
                                                                    </span>
                                                                    <% } %>
                                                                        <% if (evt.editTeam) { %>
                                                                            <span
                                                                                class="inline-flex items-center px-2 py-1 rounded-md text-[10px] font-bold bg-emerald-50 text-emerald-600">
                                                                                <i
                                                                                    class="fas fa-laptop mr-1.5 opacity-70"></i>
                                                                                <%= evt.editTeam %>
                                                                            </span>
                                                                            <% } %>
                                                                                <% } else { %>
                                                                                    <span
                                                                                        class="text-[11px] text-gray-400 italic">No
                                                                                        team assigned yet</span>
                                                                                    <% } %>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="flex gap-3">
                                        <button onclick="openManageServicesModal('<%= evt._id %>', 'Shoot')"
                                            class="flex-1 py-2.5 rounded-xl text-xs font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 transition-colors flex items-center justify-center gap-2">
                                            + Shoot Team
                                        </button>
                                        <button onclick="openManageServicesModal('<%= evt._id %>', 'Edit')"
                                            class="flex-1 py-2.5 rounded-xl text-xs font-bold text-emerald-600 bg-emerald-50 hover:bg-emerald-100 transition-colors flex items-center justify-center gap-2">
                                            + Edit Team
                                        </button>
                                    </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>

                        <!-- Related Events -->
                        <% if (relatedClients && relatedClients.length> 0) { %>
                            <div>
                                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-3 px-1">Related
                                    Events
                                </h3>
                                <div class="space-y-2">
                                    <% relatedClients.forEach(rel=> { %>
                                        <a href="/clients/<%= rel._id %>"
                                            class="block bg-white p-3 rounded-xl border border-gray-100 shadow-sm flex justify-between items-center hover:bg-gray-50 transition-colors">
                                            <div>
                                                <p class="text-sm font-bold text-gray-900">
                                                    <%= rel.event %>
                                                </p>
                                                <p class="text-xs text-gray-500">
                                                    <%= rel.eventDate ? moment(rel.eventDate).format('MMM Do, YY')
                                                        : 'TBD' %>
                                                        <% if (rel.location) { %> <span class="mx-1">•</span>
                                                            <%= rel.location %>
                                                                <% } %>
                                                </p>
                                            </div>
                                            <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                                        </a>
                                        <% }) %>
                                </div>
                            </div>
                            <% } %>

            </div>

            <!-- Edit Info Modal -->
            <div id="editModal"
                class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
                <div class="bg-white w-full max-w-md rounded-2xl p-6 animate-slide-up">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-lg font-bold text-gray-900">Edit Details</h3>
                        <button onclick="document.getElementById('editModal').classList.add('hidden')"
                            class="text-gray-400 hover:text-gray-600">
                            <i class="fas fa-times text-xl"></i>
                        </button>
                    </div>

                    <form action="/clients/<%= client._id %>" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Event
                                Type</label>
                            <input type="text" name="event" value="<%= client.event %>"
                                class="w-full rounded-xl border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-primary-500 transition-all font-medium">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Location</label>
                            <input type="text" name="location" value="<%= client.location %>"
                                class="w-full rounded-xl border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-primary-500 transition-all font-medium">
                        </div>

                        <button type="submit"
                            class="w-full btn-primary py-3.5 rounded-xl font-bold shadow-lg shadow-primary-600/30 mt-2">
                            Save Changes
                        </button>
                    </form>
                </div>
            </div>

            <!-- Assign Service Modal -->
            <div id="assignModal"
                class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
                <div class="bg-white w-full max-w-md rounded-2xl p-6 animate-slide-up">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-lg font-bold text-gray-900">Add <span id="assignTypeLabel"></span> Service</h3>
                        <button onclick="document.getElementById('assignModal').classList.add('hidden')"
                            class="text-gray-400 hover:text-gray-600">
                            <i class="fas fa-times text-xl"></i>
                        </button>
                    </div>

                    <form action="/clients/<%= client._id %>/assign" method="POST" class="space-y-4">
                        <input type="hidden" name="type" id="assignTypeInput">
                        <input type="hidden" name="eventId" id="assignEventId">

                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Service
                                Name</label>

                            <div class="relative">
                                <select id="serviceSelect" name="serviceName" required
                                    onchange="toggleCustomService(this)"
                                    class="w-full rounded-xl border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-primary-500 transition-all font-medium py-3 appearance-none pl-3 pr-10">
                                    <option value="">Select Service...</option>
                                    <% if (typeof availableServices !=='undefined' && availableServices.length> 0) { %>
                                        <% availableServices.forEach(svc=> { %>
                                            <option value="<%= svc %>">
                                                <%= svc %>
                                            </option>
                                            <% }) %>
                                                <% } %>
                                                    <option value="__custom__"
                                                        class="font-bold text-indigo-600 bg-indigo-50">+
                                                        Enter Custom Name...</option>
                                </select>
                                <div
                                    class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500">
                                    <i class="fas fa-chevron-down text-xs"></i>
                                </div>
                            </div>

                            <input type="text" id="customServiceInput" disabled
                                class="hidden w-full rounded-xl border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-primary-500 transition-all font-medium py-3"
                                placeholder="Enter custom service name">

                            <button type="button" id="resetServiceSelect" onclick="resetServiceSelection()"
                                class="hidden text-xs text-indigo-600 font-bold mt-2 hover:underline flex items-center gap-1">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </button>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Assign
                                To</label>
                            <select name="assignedTo" required
                                class="w-full rounded-xl border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-primary-500 transition-all font-medium py-3">
                                <% users.forEach(user=> { %>
                                    <option value="<%= user._id %>">
                                        <%= user.name %> (<%= user.role ? user.role.name : 'Staff' %>)
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <button type="submit"
                            class="w-full btn-primary py-3.5 rounded-xl font-bold shadow-lg shadow-primary-600/30 mt-2">
                            Assign Service
                        </button>
                    </form>
                </div>
            </div>

</div>

<!-- Manage Services Modal (Expanded View) -->
<div id="manageServicesModal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog"
    aria-modal="true">
    <div class="fixed inset-0 bg-gray-900/60 transition-opacity backdrop-blur-sm" onclick="closeManageModal()"></div>

    <div
        class="fixed inset-x-0 bottom-0 sm:inset-0 sm:flex sm:items-center sm:justify-center p-0 sm:p-4 z-10 transition-transform transform translate-y-0">
        <div
            class="bg-white rounded-t-3xl sm:rounded-2xl shadow-xl w-full sm:max-w-md max-h-[85vh] flex flex-col overflow-hidden animate-slide-up">

            <!-- Header -->
            <div class="px-5 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                <div>
                    <h3 id="manageModalTitle" class="text-lg font-bold text-gray-900">Manage Services</h3>
                    <p class="text-xs text-gray-500">Add or edit team members</p>
                </div>
                <button onclick="closeManageModal()"
                    class="text-gray-400 hover:text-gray-600 p-2 rounded-full hover:bg-gray-100 transition-colors">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>

            <!-- Form Body -->
            <div class="p-5 overflow-y-auto flex-1 custom-scrollbar">
                <form id="manageServicesForm" method="POST" action="">
                    <input type="hidden" name="type" id="manageTypeInput">
                    <input type="hidden" name="assignments" id="manageAssignmentsJson">

                    <div id="servicesListContainer" class="space-y-3">
                        <!-- Dynamic Rows Here -->
                    </div>

                    <div class="mt-4 pt-4 border-t border-dashed border-gray-200">
                        <button type="button" onclick="addNewServiceRow()"
                            class="w-full py-2.5 rounded-xl border border-dashed border-indigo-300 text-indigo-600 font-bold text-xs hover:bg-indigo-50 transition-colors flex items-center justify-center gap-2">
                            <i class="fas fa-plus"></i> Add Another Service
                        </button>
                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="p-4 border-t border-gray-100 bg-gray-50/50">
                <button type="button" onclick="submitManageForm()"
                    class="w-full btn-primary py-3.5 rounded-xl font-bold shadow-lg shadow-primary-600/30 text-sm">
                    Save All Changes
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Data Injection
    const allUsers = <% - JSON.stringify(users.map(u => ({ _id: u._id, name: u.name, role: u.role ? u.role.name : '' }))) %>;

    // Available Services Global List
    const globalServices = <% - JSON.stringify(typeof availableServices !== 'undefined' ? availableServices : []) %>;

    // Map Event ID to its full object (including assignments)
    const eventsMap = {};
    <% if (typeof clientEvents !== 'undefined' && clientEvents.length > 0) { %>
        <% clientEvents.forEach(evt => { %>
        eventsMap['<%= evt._id %>'] = <% - JSON.stringify(evt) %>;
        <% }) %>
    <% } %>

        let currentEventId = null;
    let currentType = null;

    function openManageServicesModal(eventId, type) {
        currentEventId = eventId;
        currentType = type;
        const currentEvent = eventsMap[eventId];

        // UI Setup
        document.getElementById('manageModalTitle').innerText = (type === 'Shoot' ? 'SHOOT' : 'EDIT') + ' SERVICES';
        document.getElementById('manageTypeInput').value = type;

        // Form Action
        const form = document.getElementById('manageServicesForm');
        form.action = `/clients/${currentEvent.client}/events/${eventId}/sync-assignments`;

        const container = document.getElementById('servicesListContainer');
        container.innerHTML = '';

        // Pre-fill existing assignments of this type
        // We also want to include services listed in `services` string even if unassigned, 
        // IF they match the context (how do we know which type a service string belongs to? We don't really, unless we guess or check history).
        // Let's rely on `assignedEmployees` for robust data, plus maybe parsing `services` string and checking if any are missing from assignments.

        const assignments = currentEvent.assignedEmployees ? currentEvent.assignedEmployees.filter(a => a.type === type) : [];

        // Render existing assignments
        assignments.forEach(a => {
            addServiceRow(a.service, a.assigneeId);
        });

        // If empty, add one empty row
        if (assignments.length === 0) {
            addServiceRow();
        }

        document.getElementById('manageServicesModal').classList.remove('hidden');
    }

    function closeManageModal() {
        document.getElementById('manageServicesModal').classList.add('hidden');
    }

    function addServiceRow(preService = '', preUser = '') {
        const container = document.getElementById('servicesListContainer');
        const index = container.children.length;

        const row = document.createElement('div');
        row.className = "p-3 bg-gray-50 rounded-xl border border-gray-200 relative group animate-fade-in";

        // Service Select/Input
        let serviceOptions = `<option value="">Select Service...</option>`;
        globalServices.forEach(s => {
            const selected = s === preService ? 'selected' : '';
            serviceOptions += `<option value="${s}" ${selected}>${s}</option>`;
        });
        // Check if preService is custom
        if (preService && !globalServices.includes(preService)) {
            serviceOptions += `<option value="${preService}" selected>${preService}</option>`;
        }
        serviceOptions += `<option value="__custom__" class="font-bold text-indigo-600">+ Custom...</option>`;

        // User Select
        let userOptions = `<option value="">Unassigned</option>`;
        allUsers.forEach(u => {
            const selected = u._id === preUser ? 'selected' : '';
            userOptions += `<option value="${u._id}" ${selected}>${u.name}</option>`;
        });

        row.innerHTML = `
            <div class="flex flex-col gap-2">
                <div class="relative">
                    <label class="text-[10px] font-bold text-indigo-900 uppercase tracking-wider ml-1 mb-0.5 block">Service</label>
                    <select class="service-select w-full rounded-lg border-gray-200 text-sm font-medium focus:ring-2 focus:ring-indigo-500 py-2"
                        onchange="handleServiceChange(this)">
                        ${serviceOptions}
                    </select>
                    <input type="text" class="custom-service-input hidden w-full rounded-lg border-gray-200 text-sm mt-1" placeholder="Enter service name..." value="${preService}">
                </div>
                <div class="relative">
                    <label class="text-[10px] font-bold text-emerald-900 uppercase tracking-wider ml-1 mb-0.5 block">Assignee</label>
                    <select class="user-select w-full rounded-lg border-gray-200 text-sm font-medium focus:ring-2 focus:ring-emerald-500 py-2">
                        ${userOptions}
                    </select>
                </div>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="absolute top-2 right-2 text-gray-300 hover:text-red-500 transition-colors">
                <i class="fas fa-trash-alt text-xs"></i>
            </button>
        `;

        container.appendChild(row);
    }

    function handleServiceChange(select) {
        if (select.value === '__custom__') {
            const input = select.nextElementSibling; // The input
            select.classList.add('hidden');
            input.classList.remove('hidden');
            input.focus();
        }
    }

    function submitManageForm() {
        const container = document.getElementById('servicesListContainer');
        const rows = container.children;
        const payload = [];

        for (let row of rows) {
            const serviceSelect = row.querySelector('.service-select');
            const customInput = row.querySelector('.custom-service-input');
            const userSelect = row.querySelector('.user-select');

            let serviceName = serviceSelect.value;
            if (serviceSelect.classList.contains('hidden')) {
                serviceName = customInput.value;
            }

            if (serviceName && serviceName !== '__custom__') {
                payload.push({
                    serviceName: serviceName,
                    assignedTo: userSelect.value
                });
            }
        }

        document.getElementById('manageAssignmentsJson').value = JSON.stringify(payload);
        document.getElementById('manageServicesForm').submit();
    }
</script>

<style>
    @keyframes slide-up {
        from {
            transform: translateY(100%);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .animate-slide-up {
        animation: slide-up 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fade-in 0.2s ease-out;
    }

    /* Custom Scrollbar for form */
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        bg: transparent;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: #e2e8f0;
        border-radius: 20px;
    }
</style>