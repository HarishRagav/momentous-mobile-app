<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Momentous Owner</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-gray-50 text-gray-800 font-sans pb-20">

    <!-- Top Navigation -->
    <nav class="bg-white shadow-sm px-4 py-3 sticky top-0 z-50 flex justify-between items-center">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center text-white font-bold">M</div>
            <h1 class="text-lg font-bold text-gray-900">Owner App</h1>
        </div>
        <div class="flex items-center gap-3">
            <a href="/logout" class="text-gray-500 hover:text-red-500">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="p-4">
        <%- body %>
    </main>

    <!-- Bottom Navigation -->
    <nav
        class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-6 py-3 flex justify-between items-center z-50">
        <a href="/" class="flex flex-col items-center gap-1 <%= path === '/' ? 'text-primary-600' : 'text-gray-400' %>">
            <i class="fas fa-home text-xl"></i>
            <span class="text-xs font-medium">Home</span>
        </a>
        <a href="/clients"
            class="flex flex-col items-center gap-1 <%= path.includes('/clients') ? 'text-primary-600' : 'text-gray-400' %>">
            <i class="fas fa-users text-xl"></i>
            <span class="text-xs font-medium">CRM</span>
        </a>
        <a href="/attendance"
            class="flex flex-col items-center gap-1 <%= path.includes('/attendance') ? 'text-primary-600' : 'text-gray-400' %>">
            <i class="fas fa-clock text-xl"></i>
            <span class="text-xs font-medium">Team</span>
        </a>
        <a href="/payroll"
            class="flex flex-col items-center gap-1 <%= path.includes('/payroll') ? 'text-primary-600' : 'text-gray-400' %>">
            <i class="fas fa-file-invoice-dollar text-xl"></i>
            <span class="text-xs font-medium">Payroll</span>
        </a>
    </nav>

</body>

</html>