<div class="space-y-6 pb-20">
    <!-- Header -->
    <div class="flex items-center justify-between sticky top-0 bg-gray-50 py-4 z-10">
        <h2 class="text-xl font-bold text-gray-900">Payroll</h2>
        <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-full shadow-sm border border-gray-100">
            <i class="fas fa-calendar text-gray-400 text-xs"></i>
            <span class="text-sm font-bold text-gray-700">
                <%= monthName %>
                    <%= year %>
            </span>
        </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 gap-4">
        <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 relative overflow-hidden">
            <div
                class="absolute right-0 top-0 w-16 h-16 bg-gradient-to-br from-green-50 to-transparent rounded-bl-full -z-0">
            </div>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1 relative z-10">Total Payout</p>
            <h3 class="text-2xl font-bold text-gray-900 relative z-10">₹<%= totalPayout.toLocaleString() %>
            </h3>
        </div>
        <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 relative overflow-hidden">
            <div
                class="absolute right-0 top-0 w-16 h-16 bg-gradient-to-br from-orange-50 to-transparent rounded-bl-full -z-0">
            </div>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1 relative z-10">Pending</p>
            <h3 class="text-2xl font-bold text-orange-600 relative z-10">
                <%= pendingCount %>
            </h3>
        </div>
    </div>

    <!-- List -->
    <div class="space-y-3">
        <% if (typeof payrolls !=='undefined' && payrolls.length> 0) { %>
            <% payrolls.forEach(p=> { %>
                <div
                    class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between active:scale-[0.99] transition-transform">
                    <div class="flex items-center gap-3">
                        <div
                            class="w-10 h-10 rounded-full overflow-hidden bg-gray-200 border-2 border-white shadow-sm flex-shrink-0">
                            <img src="<%= p.user.profilePhoto || 'https://ui-avatars.com/api/?name=' + p.user.name %>"
                                class="w-full h-full object-cover">
                        </div>
                        <div>
                            <h4 class="text-sm font-bold text-gray-900 leading-tight">
                                <%= p.user.name %>
                            </h4>
                            <p class="text-[10px] text-gray-500 mt-1">
                                <span class="bg-gray-100 px-1.5 rounded text-gray-600">
                                    <%= p.presentDays %> Present
                                </span>
                                <span class="ml-1">
                                    <%= p.workingDays %> Days
                                </span>
                            </p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-sm font-bold text-gray-900">₹<%= p.netSalary.toLocaleString() %>
                        </p>
                        <span
                            class="text-[10px] px-2 py-0.5 rounded-full <%= p.status === 'Paid' ? 'bg-green-100 text-green-700' : 'bg-orange-100 text-orange-700' %> font-bold inline-block mt-1">
                            <%= p.status %>
                        </span>
                    </div>
                </div>
                <% }) %>
                    <% } else { %>
                        <div class="text-center py-12 bg-white rounded-2xl border border-dashed border-gray-200">
                            <div
                                class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-3 text-gray-300">
                                <i class="fas fa-file-invoice-dollar text-xl"></i>
                            </div>
                            <p class="text-sm font-bold text-gray-900">No Records</p>
                            <p class="text-xs text-gray-400 mt-1">Payroll has not been generated for this month.</p>
                            <!-- Placeholder Action -->
                            <button
                                class="mt-4 px-4 py-2 bg-indigo-50 text-indigo-600 rounded-xl text-xs font-bold hover:bg-indigo-100 transition-colors">
                                Generate Draft
                            </button>
                        </div>
                        <% } %>
    </div>
</div>